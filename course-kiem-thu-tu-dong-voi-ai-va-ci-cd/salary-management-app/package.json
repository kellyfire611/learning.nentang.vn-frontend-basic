{
  "name": "salary-management-app",
  "version": "1.0.0",
  "description": "Bài mẫu quản lý nhân viên và lập bảng lương bằng HTML, CSS, JavaScript, JSON Server, Vitest và Playwright.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "json-server --watch db.json --port 3000",
    "test": "vitest run tests/unit tests/business",
    "test:unit": "vitest run tests/unit",
    "test:business": "vitest run tests/business",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "json-server": "^0.17.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
