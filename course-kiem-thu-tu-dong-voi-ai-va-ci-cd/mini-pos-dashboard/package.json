{
  "name": "mini-pos-dashboard",
  "version": "1.0.0",
  "description": "Mini POS bán hàng, trừ kho, lưu đơn hàng, dashboard báo cáo, Vitest và Playwright",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "api": "json-server --watch db.json --host 127.0.0.1 --port 3000",
    "reset-db": "node scripts/reset-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e"
  },
  "keywords": [
    "mini-pos",
    "json-server",
    "vitest",
    "playwright",
    "chartjs"
  ],
  "author": "NenTang.vn",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "json-server": "^0.17.4"
  }
}
